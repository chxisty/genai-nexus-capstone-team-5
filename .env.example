# ==========================================
# Railway Passenger Help Desk - Environment Configuration
# Copy this file to .env locally and fill in your API key(s).
# NEVER commit .env or real API keys to Git!
# ==========================================

# Provider selection: "gemini" (default), "groq", or "auto"
# - "gemini" (default): uses Google Gemini (official capstone evaluation default).
# - "groq": uses Groq API (fast inference for development/testing).
# - "auto": prefers Gemini if GEMINI_API_KEY is set, else Groq if GROQ_API_KEY is set.
LLM_PROVIDER=gemini

# Google Gemini API (official capstone evaluation provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq API (configurable alternative provider)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional LLM request tuning
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.1
