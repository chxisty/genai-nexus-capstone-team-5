# ==========================================
# Railway Passenger Help Desk - Environment Configuration
# Copy this file to .env locally and fill in your API key(s).
# NEVER commit .env or real API keys to Git!
# ==========================================

# Provider selection: "gemini" (default), "groq", or "auto"
# - "gemini" (default): uses Google Gemini via the google-genai SDK.
# - "groq": uses Groq API (fast inference for development/testing).
# - "auto": prefers Gemini if GEMINI_API_KEY is set, else Groq if GROQ_API_KEY is set.
LLM_PROVIDER=gemini

# Google Gemini API (verified available model from authenticated list)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq API (verified available tool-calling model from authenticated list)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional LLM request tuning (timeout in seconds or milliseconds, e.g. 120 or 120000)
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.1
